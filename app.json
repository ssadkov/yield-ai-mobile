{
  "expo": {
    "name": "Yield AI",
    "owner": "sadkovs-team",
    "slug": "yieldai",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "yieldaimobile",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yieldai.mobile",
      "appleTeamId": "RY26UXEX58",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "phantom",
          "solflare",
          "backpack",
          "jupiter",
          "glow",
          "petra",
          "martian",
          "metamask",
          "trust",
          "okx",
          "bitkeep",
          "cbwallet",
          "rainbow",
          "uniswap"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/android-icon-foreground.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "com.solanamobile.seedvault.ACCESS_SEED_VAULT"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.yieldai.mobile"
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/d29f82e7-7767-44bf-9282-273a09e8ac3c"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "./plugins/withAndroidWalletQueries",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "autolinking": {
      "nativeModulesDir": "./modules"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d29f82e7-7767-44bf-9282-273a09e8ac3c"
      }
    }
  }
}
