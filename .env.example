# Optional Solana RPC override for mobile sign-and-submit fallback.
# Prefer cluster-specific URLs when you switch clusters in the dev panel.
# EXPO_PUBLIC_SOLANA_RPC_URL_MAINNET_BETA=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# EXPO_PUBLIC_SOLANA_RPC_URL_DEVNET=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
# EXPO_PUBLIC_SOLANA_RPC_URL_TESTNET=https://api.testnet.solana.com
# EXPO_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# WalletConnect v2 project id. Register at https://cloud.reown.com
EXPO_PUBLIC_WC_PROJECT_ID=

# Privy ("Sign in with Google" + embedded Solana wallet). The Privy app is created by the
# backend dev at dashboard.privy.io. Leave empty to keep Privy as "Soon" on the Connect sheet.
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# Real deposits/withdrawals through the Yield AI Safe API. Leave empty for the mock portfolio.
#   devnet  — idle USDC only (test tokens)
#   mainnet — real USDC: Flexible = Kamino, Fixed = Exponent PT until 10 Jan 2027
# EXPO_PUBLIC_YIELD_API_BASE overrides the API origin of the selected network.
# EXPO_PUBLIC_YIELD_NETWORK=mainnet
