{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "dapp-store": {
      "distribution": "store",
      "credentialsSource": "local",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_MAIN_WEBVIEW_URL": "https://yieldai.app/"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_MAIN_WEBVIEW_URL": "https://yieldai.app/"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "devnet": {
      "distribution": "internal",
      "channel": "devnet",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_MAIN_WEBVIEW_URL": "https://yieldai.app/",
        "EXPO_PUBLIC_YIELD_NETWORK": "devnet"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
